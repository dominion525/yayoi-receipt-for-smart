{
  "name": "yayoi-receipt-for-smart",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.worker.json && npm run lint && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260420.1",
    "@eslint/js": "^9.38.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vitest": "^0.5.4",
    "happy-dom": "^18.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^6.0.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@types/alpinejs": "^3.13.11",
    "alpinejs": "^3.14.9",
    "resend": "^3.2.0"
  }
}
